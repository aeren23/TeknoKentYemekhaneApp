@page "/mealrecords"
@using Microsoft.AspNetCore.Authorization
@using YemekhaneApp.Frontend.Models.MealRecord
@using YemekhaneApp.Frontend.Services
@inject MealRecordService MealRecordService
@inject NavigationManager NavigationManager

@attribute [Authorize]


@code {
    private List<MealRecordViewModel>? allMealRecords = new();
    private List<MealRecordViewModel>? filteredMealDays = new();
    private int selectedYear = DateTime.Now.Year;
    private int selectedMonth = DateTime.Now.Month;
    private bool showAll = false;
    private List<int> Years = Enumerable.Range(DateTime.Now.Year - 5, 6).ToList();
    private int rowIndex = 0;

    private int SelectedYear
    {
        get => selectedYear;
        set
        {
            if (selectedYear != value)
            {
                selectedYear = value;
                showAll = false;
                _ = FilterMealDays();
            }
        }
    }

    private int SelectedMonth
    {
        get => selectedMonth;
        set
        {
            if (selectedMonth != value)
            {
                selectedMonth = value;
                showAll = false;
                _ = FilterMealDays();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        allMealRecords = await MealRecordService.GetMealRecordsAsync();
        await FilterMealDays();
    }

    private async Task FilterMealDays()
    {
        if (allMealRecords is null)
        {
            filteredMealDays = new List<MealRecordViewModel>();
            return;
        }

        if (showAll)
        {
            filteredMealDays = allMealRecords
                .GroupBy(x => x.MealDate)
                .Select(g => g.FirstOrDefault())
                .OrderByDescending(x => x.MealDate)
                .ToList();
        }
        else
        {
            filteredMealDays = allMealRecords
                .Where(r => r.MealDate.Year == SelectedYear && r.MealDate.Month == SelectedMonth)
                .GroupBy(x => x.MealDate)
                .Select(g => g.FirstOrDefault())
                .OrderByDescending(x => x.MealDate)
                .ToList();
        }
        rowIndex = 0;
        StateHasChanged();
    }

    private async Task ShowAllRecords()
    {
        showAll = true;
        await FilterMealDays();
    }

    private async Task ShowCurrentMonth()
    {
        showAll = false;
        SelectedYear = DateTime.Now.Year;
        SelectedMonth = DateTime.Now.Month;
        await FilterMealDays();
    }

    private void GoToDetail(Guid id)
    {
        NavigationManager.NavigateTo($"/mealrecords/{id}");
    }
}

<h3 class="mb-4">Yemek Yenen Günler</h3>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form class="row g-3 align-items-center">
            <div class="col-auto">
                <label for="yearSelect" class="col-form-label fw-semibold">Yıl:</label>
            </div>
            <div class="col-auto">
                <select id="yearSelect" class="form-select" style="min-width: 90px;" @bind="SelectedYear" disabled="@showAll">
                    @foreach (var year in Years)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label for="monthSelect" class="col-form-label fw-semibold">Ay:</label>
            </div>
            <div class="col-auto">
                <select id="monthSelect" class="form-select" style="min-width: 90px;" @bind="SelectedMonth" disabled="@showAll">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@m.ToString("00")</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-primary" @onclick="ShowCurrentMonth" disabled="@(!showAll)">
                    Bu Ayı Göster
                </button>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-secondary" @onclick="ShowAllRecords" disabled="@showAll">
                    Tüm Kayıtları Göster
                </button>
            </div>
        </form>
    </div>
</div>

@if (filteredMealDays is null)
{
    <div class="alert alert-info">Yükleniyor...</div>
}
else if (!filteredMealDays.Any())
{
    <div class="alert alert-warning">Kayıt bulunamadı.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Tarih</th>
                    <th>Detay</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in filteredMealDays)
                {
                    <tr>
                        <td>@(++rowIndex)</td>
                        <td>@record.MealDate.ToString("dd.MM.yyyy")</td>
                        <td>
                            <button class="btn btn-info btn-sm" @onclick="() => GoToDetail(record.Id)">
                                Detay
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}