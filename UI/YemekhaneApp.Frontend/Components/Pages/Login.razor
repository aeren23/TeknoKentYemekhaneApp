@page "/login"
@using Microsoft.AspNetCore.Components.Authorization
@using YemekhaneApp.Frontend.Models.Auth
@using YemekhaneApp.Frontend.Services
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider

<div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-primary text-white text-center">
                <h3 class="mb-0"><i class="bi bi-person-circle me-2"></i>Giriş Yap</h3>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger text-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ErrorMessage
                    </div>
                }
                <EditForm Model="authRequest" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="mb-3">
                        <label for="passwordInput" class="form-label fw-semibold">Şifre</label>
                        <InputText id="passwordInput" @bind-Value="authRequest.Password" type="password" class="form-control form-control-lg" placeholder="Şifrenizi girin" autocomplete="current-password" required />
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg" disabled="@IsLoading">
                            @if (IsLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Giriş Yapılıyor...</span>
                            }
                            else
                            {
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                <span>Giriş Yap</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private AuthRequestViewModel authRequest = new();
    private string ErrorMessage { get; set; }
    private bool IsLoading { get; set; }
    private bool _trustedChecked = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_trustedChecked)
        {
            _trustedChecked = true;

            // 1. Token sessionStorage'da varsa, direkt giriş yap
            var token = await AuthService.GetTokenFromSessionAsync();
            if (!string.IsNullOrEmpty(token))
            {
                if (AuthStateProvider is CustomAuthenticationStateProvider customProvider)
                    customProvider.AuthenticateUser(token);

                Navigation.NavigateTo("/");
                return;
            }

            // 2. Trusted device kontrolü
            var userAgent = await JSRuntime.InvokeAsync<string>("getUserAgent");
            var trustedResult = await AuthService.IsTrustedUserAgent(userAgent);

            if (trustedResult != null && !string.IsNullOrEmpty(trustedResult.Token))
            {
                await AuthService.SetTokenToSessionAsync(trustedResult.Token);

                if (AuthStateProvider is CustomAuthenticationStateProvider customProvider)
                    customProvider.AuthenticateUser(trustedResult.Token);

                Navigation.NavigateTo("/");
            }
            // trustedResult null ise, kullanıcıdan şifre istenir (form gösterilir)
        }
    }

    private async Task HandleValidSubmit()
    {
        IsLoading = true;
        ErrorMessage = null;
        StateHasChanged();

        var result = await AuthService.Authenticate(authRequest);

        if (result != null && !string.IsNullOrEmpty(result.Token))
        {
            await AuthService.SetTokenToSessionAsync(result.Token);

            if (AuthStateProvider is CustomAuthenticationStateProvider customProvider)
                customProvider.AuthenticateUser(result.Token);

            Navigation.NavigateTo("/");
        }
        else
        {
            ErrorMessage = "Şifre hatalı.";
        }

        IsLoading = false;
        StateHasChanged();
    }
}