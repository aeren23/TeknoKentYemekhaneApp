@page "/login"
@using Microsoft.AspNetCore.Components.Authorization
@using YemekhaneApp.Frontend.Models.Auth
@using YemekhaneApp.Frontend.Services
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider

<div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-primary text-white text-center">
                <h3 class="mb-0"><i class="bi bi-person-circle me-2"></i>Giriş Yap</h3>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger text-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ErrorMessage
                    </div>
                }
                <form @onsubmit="LoginAsync">
                    <div class="mb-3">
                        <label for="passwordInput" class="form-label fw-semibold">Şifre</label>
                        <input id="passwordInput" @bind="Password" type="password" class="form-control form-control-lg" placeholder="Şifrenizi girin" autocomplete="current-password" required />
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg" disabled="@IsLoading">
                            @if (IsLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Giriş Yapılıyor...</span>
                            }
                            else
                            {
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                <span>Giriş Yap</span>
                            }
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@code {
    private string Password { get; set; }
    private string ErrorMessage { get; set; }
    private bool IsLoading { get; set; }
    private bool _trustedChecked = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_trustedChecked)
        {
            _trustedChecked = true;
            try
            {
                // 1. Token zaten varsa, state'i güncelle ve yönlendir
                var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "jwtToken");
                if (!string.IsNullOrEmpty(token))
                {
                    if (AuthStateProvider is CustomAuthStateProvider customProvider)
                        customProvider.SetToken();

                    await Task.Delay(100);
                    Navigation.NavigateTo("/");
                    return;
                }

                // 2. Trusted device kontrolü (user-agent ile)
                var userAgent = await JSRuntime.InvokeAsync<string>("getUserAgent");
                var trustedResult = await AuthService.IsTrustedUserAgent(userAgent);

                if (trustedResult != null && !string.IsNullOrEmpty(trustedResult.Token))
                {
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "jwtToken", trustedResult.Token);

                    if (AuthStateProvider is CustomAuthStateProvider customProvider)
                        customProvider.SetToken();

                    await Task.Delay(100);
                    Navigation.NavigateTo("/");
                }
                // trustedResult null ise, kullanıcıdan şifre istenir (form gösterilir)
            }
            catch (Exception ex)
            {
                ErrorMessage = "Otomatik giriş başarısız. Lütfen manuel giriş yapınız.";
                StateHasChanged();
            }
        }
    }

    private async Task LoginAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        StateHasChanged();

        var request = new AuthRequestViewModel
        {
            Password = Password
        };

        var result = await AuthService.Authenticate(request);

        if (result != null && !string.IsNullOrEmpty(result.Token))
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "jwtToken", result.Token);

            if (AuthStateProvider is CustomAuthStateProvider customProvider)
                customProvider.SetToken();

            await Task.Delay(100);
            Navigation.NavigateTo("/");
        }
        else
        {
            ErrorMessage = "Şifre hatalı.";
        }

        IsLoading = false;
        StateHasChanged();
    }
}