@page "/extralar/duzenle/{Id:guid}"
@using Microsoft.AspNetCore.Authorization
@using YemekhaneApp.Frontend.Models.Extra
@using YemekhaneApp.Frontend.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ExtraService ExtraService
@inject NavigationManager NavigationManager

@attribute [Authorize]


<h3>Ekstra Düzenle</h3>

@if (extra == null)
{
    <div>Yükleniyor...</div>
}
else
{
    <EditForm Model="extra" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Adı</label>
            <InputText class="form-control" @bind-Value="extra.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">Fiyat</label>
            <InputNumber class="form-control" @bind-Value="extra.Price" />
        </div>
        <button class="btn btn-primary" type="submit">Güncelle</button>
        <button class="btn btn-secondary ms-2" type="button" @onclick='@(() => NavigationManager.NavigateTo("/extralar"))'>İptal</button>
    </EditForm>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private ExtraUpdateViewModel? extra;

    protected override async Task OnInitializedAsync()
    {
        var data = await ExtraService.GetExtraByIdAsync(Id);
        if (data != null)
        {
            extra = new ExtraUpdateViewModel
            {
                Id = data.Id,
                Name = data.Name,
                Price = data.Price
            };
        }
    }

    private async Task HandleValidSubmit()
    {
        if (extra != null)
        {
            var success = await ExtraService.UpdateExtraAsync(extra);
            if (success)
            {
                NavigationManager.NavigateTo("/extralar");
            }
        }
    }
}