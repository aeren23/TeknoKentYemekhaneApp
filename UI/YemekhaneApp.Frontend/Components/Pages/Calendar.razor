@page "/"
@using YemekhaneApp.Frontend.Models.Employee
@using YemekhaneApp.Frontend.Models.Extra
@using YemekhaneApp.Frontend.Services
@inject EmployeeService EmployeeService
@inject MealRecordService MealRecordService
@inject ExtraService ExtraService
@inject IJSRuntime JS

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0 d-flex justify-content-between align-items-center">
                        Yemek Kaydı Ekle
                        <button class="btn btn-success" @onclick="SaveMealRecord" disabled="@(SelectedEmployeeId == Guid.Empty || SelectedDate == null)">
                            <i class="bi bi-plus-circle"></i> Kaydet
                        </button>
                    </h4>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger mt-3">@ErrorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(SuccessMessage))
                    {
                        <div class="alert alert-success mt-3">@SuccessMessage</div>
                    }
                    <div class="mb-3">
                        <label for="dateInput" class="form-label">Tarih</label>
                        <input id="dateInput" type="date" class="form-control" @bind="SelectedDate"
                               min="@MinDateString"
                               max="@MaxDateString"
                               required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label d-flex align-items-center">
                            Çalışanlar 
                            <button type="button" class="btn btn-success btn-sm ms-2" title="Çalışan Ekle" @onclick="ShowAddModal">
                                <i class="bi bi-plus"></i>
                            </button>
                        </label>
                        
                        <div class="list-group">
                            @if (Employees != null)
                            {
                                foreach (var employee in Employees)
                                {
                                    <button type="button"
                                            class="list-group-item list-group-item-action @(SelectedEmployeeId == employee.Id ? "active" : "")"
                                            @onclick="() => SelectEmployee(employee.Id)">
                                        @employee.Name @employee.Surname
                                    </button>
                                }
                            }
                        </div>
                    </div>
                    <div class="mb-3">
                        <button class="btn btn-outline-secondary" type="button" @onclick="ToggleExtras">
                            <i class="bi bi-plus-circle"></i> Ekstra Ekle
                        </button>
                        @if (ShowExtras)
                        {
                            <div class="mt-2 border rounded p-2 bg-light">
                                <label class="form-label">Ekstralar (Opsiyonel)</label>
                                <div class="list-group">
                                    @if (Extras != null)
                                    {
                                        foreach (var extra in Extras)
                                        {
                                            <label class="list-group-item">
                                                <input type="checkbox"
                                                       class="form-check-input me-1"
                                                       value="@extra.Id"
                                                       @onchange="e => OnExtraChanged(e, extra.Id)"
                                                       checked="@SelectedExtraIds.Contains(extra.Id)" />
                                                @extra.Name (@extra.Price.ToString("C2"))
                                            </label>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (showAddModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Çalışan Ekle</h5>
                    <button type="button" class="btn-close" @onclick="CloseAddModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="newEmployee" OnValidSubmit="AddEmployeeAsync">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Ad</label>
                            <InputText class="form-control" @bind-Value="newEmployee.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Soyad</label>
                            <InputText class="form-control" @bind-Value="newEmployee.Surname" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <InputText class="form-control" @bind-Value="newEmployee.Email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Telefon</label>
                            <InputText class="form-control" @bind-Value="newEmployee.PhoneNumber" />
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                            <button type="button" class="btn btn-secondary" @onclick="CloseAddModal">Geri Dön</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<EmployeeViewModel> Employees;
    private Guid SelectedEmployeeId;
    private DateTime? SelectedDate;
    private string? SuccessMessage;
    private string? ErrorMessage;

    private List<ExtraViewModel> Extras = new();
    private HashSet<Guid> SelectedExtraIds = new();
    private bool ShowExtras = false;

    // Modal için
    private bool showAddModal = false;
    private EmployeeCreateViewModel newEmployee = new();

    // Sadece bu ay ve bugüne kadar olan günler seçilebilsin
    private DateTime MinDate => new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime MaxDate => DateTime.Now.Date;
    private string MinDateString => MinDate.ToString("yyyy-MM-dd");
    private string MaxDateString => MaxDate.ToString("yyyy-MM-dd");

    protected override async Task OnInitializedAsync()
    {
        Employees = await EmployeeService.GetEmployeesAsync();
        Extras = await ExtraService.GetAllExtrasAsync();
        SelectedDate = DateTime.Now.Date; // Tarih inputunda bugünün tarihi seçili gelsin
    }

    private void SelectEmployee(Guid employeeId)
    {
        SelectedEmployeeId = employeeId;
    }

    private void ToggleExtras()
    {
        ShowExtras = !ShowExtras;
    }

    private void OnExtraChanged(ChangeEventArgs e, Guid extraId)
    {
        var isChecked = (bool?)e.Value ?? false;
        if (isChecked)
            SelectedExtraIds.Add(extraId);
        else
            SelectedExtraIds.Remove(extraId);
    }

    private async Task SaveMealRecord()
    {
        SuccessMessage = null;
        ErrorMessage = null;
        // Tarih validasyonu
        if (SelectedDate < MinDate || SelectedDate > MaxDate)
        {
            ErrorMessage = "Sadece içinde bulunduğumuz ay ve bugüne kadar olan günler için tarih seçebilirsiniz!";
            return;
        }
        if (SelectedEmployeeId != Guid.Empty && SelectedDate.HasValue)
        {
            try
            {
                await MealRecordService.AddMealRecordAsync(new MealRecordCreateViewModel
                {
                    EmployeeId = SelectedEmployeeId,
                    MealDate = DateOnly.FromDateTime(SelectedDate.Value),
                    IsEaten = true,
                    ExtraIds = SelectedExtraIds.ToList()
                });

                SuccessMessage = "Yemek kaydı başarıyla eklendi.";
                SelectedEmployeeId = Guid.Empty;
                SelectedDate = DateTime.Now.Date; // Kayıttan sonra tekrar bugünü seçili yap
                SelectedExtraIds.Clear();
                ShowExtras = false;
                Employees = await EmployeeService.GetEmployeesAsync(); // Yeni çalışan eklenmişse güncelle
            }
            catch (Exception ex)
            {
                if (ex.Message.Contains("already exists", StringComparison.OrdinalIgnoreCase) ||
                    ex.Message.Contains("aynı gün", StringComparison.OrdinalIgnoreCase) ||
                    ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase))
                {
                    ErrorMessage = "Bu çalışan için bu tarihte zaten bir yemek kaydı mevcut!";
                }
                else
                {
                    ErrorMessage = "Kayıt eklenirken bir hata oluştu ";
                }
            }
        }
    }

    // Modal işlemleri
    private void ShowAddModal()
    {
        newEmployee = new EmployeeCreateViewModel();
        showAddModal = true;
    }

    private void CloseAddModal()
    {
        showAddModal = false;
    }

    private async Task AddEmployeeAsync()
    {
        newEmployee.IsActive = true;
        await EmployeeService.AddEmployeeAsync(newEmployee);
        Employees = await EmployeeService.GetEmployeesAsync();
        showAddModal = false;
        StateHasChanged();
    }
}